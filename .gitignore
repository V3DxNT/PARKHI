._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Node & Frontend (Parki_Web & Parkhi_RN)
node_modules/
