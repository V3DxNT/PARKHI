yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
build/
dist/
.turbo/

# React Native & Expo (Parkhi_RN)
.expo/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.claude/

# Python & Machine Learning (Parkhi_Py)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.log

# Go Backend (Parkhi_Go)
/Parkhi_Go/bin/
/Parkhi_Go/server
/Parkhi_Go/*.exe
*.test
*.out

# Data & Large Temporary Assets
/data/
/storage/
