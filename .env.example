# ==============================================================================
# Parkhi Platform - Global Environment Configuration Template
# ==============================================================================

# Core Ports
BACKEND_PORT=8080
ML_GRPC_PORT=50051
WEB_PORT=3000

# Go Backend -> ML Service gRPC connection
FASTAPI_GRPC_ADDR=localhost:50051

# Database & Cache (Optional / Self-contained fallbacks available)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/parkhi_db?sslmode=disable
REDIS_URL=redis://localhost:6379

# Copernicus Data Space Ecosystem (CDSE) Credentials
CDSE_USERNAME=your_copernicus_username
CDSE_PASSWORD=your_copernicus_password
CDSE_CLIENT_ID=cdse-public

# Cloudinary Storage (Optional for GeoTIFF and preview distribution)
CLOUDINARY_URL=

# Automated Email Notifications & Monitoring Subscriptions (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@parkhi.space
SMTP_PASS=app_specific_password_here

# Public API Base URLs
BACKEND_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_API_BASE=http://localhost:8080
